# ==========================================
# Neon Song Local Build Environment Template
# Copy this file to .env or local.properties for local builds
# ==========================================

# Release Keystore Signing Credentials (Local builds)
RELEASE_STORE_FILE=app/release.keystore
RELEASE_STORE_PASSWORD=your_keystore_password_here
RELEASE_KEY_ALIAS=release_key
RELEASE_KEY_PASSWORD=your_key_password_here

# Required for strict release builds. Set the genuine value in your ignored
# .env/local.properties file; never commit the real secret.
# ADDON_CLIENT_SECRET=replace_with_real_secret

# GitHub Actions Secrets (Set in Repo Settings -> Secrets):
# ADDON_CLIENT_SECRET=<genuine addon client secret>
# SIGNING_KEY=<base64-encoded-keystore-string>
# KEY_STORE_PASSWORD=<your-keystore-password>
# ALIAS=release_key
# KEY_PASSWORD=<your-key-password>
