<?xml version="1.0" encoding="utf-8"?>
<!-- One UI Obsidian smoked glass card: 26dp corners with deep charcoal gradient & frost glass rim -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="270"
        android:startColor="#E61A1B22"
        android:endColor="#E60E0F12"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
