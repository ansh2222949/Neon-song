<?xml version="1.0" encoding="utf-8"?>
<!-- One UI Obsidian smoked glass card: 26dp corners with deep charcoal gradient & frost glass rim -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="315"
        android:startColor="#EC1E202B"
        android:centerColor="#EB13141C"
        android:endColor="#F00A0B0F"
        android:type="linear" />
    <stroke
        android:width="1.1dp"
        android:color="#33FFFFFF" />
</shape>
