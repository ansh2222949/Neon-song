<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF252A3F"
                android:centerColor="#FF151828"
                android:endColor="#FF0B0D16"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#4D00E5FF" />
        </shape>
    </item>
    <item
        android:width="28dp"
        android:height="28dp"
        android:gravity="center"
        android:drawable="@drawable/ic_widget_logo_mark" />
</layer-list>
