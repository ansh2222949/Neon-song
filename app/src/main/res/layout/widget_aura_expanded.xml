<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_aura_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_aura_name"
                android:textColor="#FFF7F8FA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/widget_aura_idle"
                android:textColor="#B0EAEFF5"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active Expanded One UI Card (3x2 / 4x2 / 5x2 / 4x3) -->
    <LinearLayout
        android:id="@+id/widget_content_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Row: Squircle Art + Title/Artist + Live Badge Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Unknown track"
                    android:textColor="#FFF7F8FA"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="Artist"
                    android:textColor="#C2EAEFF5"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_eq_group"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/widget_aura_pill_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/widget_eq_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_eq_frame_0" />

                <TextView
                    android:id="@+id/widget_source_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Neon Song"
                    android:textColor="#FFF7F8FA"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Flexible Progress Bar Zone (absorbs vertical resizing smoothly) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="#2EFFFFFF"
                android:progressTint="#FF00E5FF" />
        </LinearLayout>

        <!-- Bottom Centered One UI Transport Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_aura_icon_button"
                android:contentDescription="@string/widget_previous"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_previous" />

            <View
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/widget_play_pause_container"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_aura_play_pill">

                <ImageButton
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_play_pause"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_play" />
            </FrameLayout>

            <View
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_aura_icon_button"
                android:contentDescription="@string/widget_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
